{
  "name": "chatwrapped",
  "version": "1.0.0",
  "description": "Privacy-first conversation analytics, storytelling and share-card generator for WhatsApp and Telegram exports. Static, client-side only.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/singhtanishq/ChatWrapped.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "validate:readme": "python3 scripts/validate-readme-screenshots.py",
    "validate:links": "node scripts/validate-built-site.mjs",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.4.12",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.5",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^6.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
