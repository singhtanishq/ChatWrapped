---
import PageLayout from "@/layouts/PageLayout.astro";
import { SITE } from "@/lib/site";
---

<PageLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description="Turn your WhatsApp and Telegram conversations into beautiful, shareable recaps. Free, instant and private — processed entirely in your browser."
>
  <main id="main" class="flex min-h-dvh flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="font-display text-5xl font-bold">Your chats have a story.</h1>
    <p class="max-w-md text-zinc-400">
      ChatWrapped is under construction. Full conversation analytics, story recaps and share cards are coming to this page.
    </p>
  </main>
</PageLayout>
