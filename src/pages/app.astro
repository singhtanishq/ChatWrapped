---
import PageLayout from "@/layouts/PageLayout.astro";
import App from "@/app/main";
import { SITE } from "@/lib/site";
---

<PageLayout
  title={`ChatWrapped Analyzer — ${SITE.tagline_short}`}
  description="Import a WhatsApp or Telegram export and get accurate conversation analytics, a personalized story and shareable cards — processed entirely in your browser."
  path="/app/"
  chrome={false}
>
  <main id="main">
    <App client:load />
  </main>
</PageLayout>
